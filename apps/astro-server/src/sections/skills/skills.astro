---
import SkillDisplay from "./components/display";
import { getProjects } from "@/components/projects/project.api";

const projectAPI = getProjects();
---

<section>
	{
		projectAPI
			.then((projects) => {
				return <SkillDisplay client:load projects={projects} />;
			})
			.catch((err) => {
				console.error("failed to retrieve projects");
			})
	}
</section>
