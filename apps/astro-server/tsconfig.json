{
	"extends": "astro/tsconfigs/strict",
	"include": [".astro/types.d.ts", "**/*"],
	"exclude": ["dist"],
	"compilerOptions": {
		"ignoreDeprecations": "6.0",
		"baseUrl": ".",
		"paths": {
			"@config/*": ["src/config/*"],
			"@lib/*": ["src/lib/*"],
			"@components/*": ["src/components/*"],
			"@pages/*": ["src/pages/*"],
			"@styles/*": ["src/styles/*"],
			"@sections/*": ["src/sections/*"]
		},
		"jsx": "react-jsx",
		"jsxImportSource": "react"
	}
}
