---
import SkillDisplay from "./components/display";
import { getProjects } from "@/features/projects/project.server";
import type { Project } from "@/features/projects/project.types";

const projects: Project[] = await getProjects().catch((error) => {
	console.error("Failed to retrieve projects:", error);
	return [];
});
---

<section>
	<SkillDisplay client:load projects={projects} />
</section>
