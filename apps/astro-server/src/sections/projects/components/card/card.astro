---
import styles from "./card.module.css";
import type { SkillChipKeys } from "../skillChip/chips";
import Chip from "../skillChip/chip.astro";

interface Props {
	class: string;
	title: string;
	siteLink?: string;
	repoLink?: string;
	projectLink?: string;
	desc: string;
	skills?: SkillChipKeys[];
}

const {
	class: className,
	title,
	siteLink,
	repoLink,
	projectLink,
	desc,
	skills = [],
} = Astro.props as Props;
---

<div class={`${className} ${styles.card}`}>
	<div class={styles.card__projectImage}>
		{
			(siteLink || repoLink) && (
				<div class={styles.card__whiteSpace}>
					<img
						src="neg-radius-top-left.svg"
						alt="negative-radius"
						aria-hidden="true"
						class={styles.card__negativeRadius}
					/>
					{repoLink && (
						<button>
							<svg
								xmlns="http://www.w3.org/2000/svg"
								width="32"
								height="32"
								fill="currentColor"
								class="bi bi-github"
								viewBox="0 0 16 16"
							>
								<path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27s1.36.09 2 .27c1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8" />
							</svg>
						</button>
					)}
					{siteLink && <button> Site </button>}
					<img
						src="neg-radius-top-left.svg"
						alt="negative-radius"
						aria-hidden="true"
						class={styles.card__negativeRadius}
					/>
				</div>
			)
		}
	</div>
	<div class={styles.card__content}>
		<div class="mb-4">
			<h3 class={styles.card__title}>
				{title ?? "Title is Missing"}
			</h3>
			<span class="flex flex-row gap-2">
				{skills.map((skill) => <Chip chip={skill} />)}
			</span>
		</div>
		<p class={styles.card__desc}>{desc}</p>
		<a class={styles.card__moreInfoButton} href={projectLink}>
			Read More
		</a>
	</div>
</div>
