---
import styles from "./stack.module.css";
import SkillDisplay from "./component/display";
import { getProjects } from "@/components/projects/project.api";

const projects = getProjects();
---

<section class={styles.stack}>
	{
		projects.then((projects) => (
			<SkillDisplay client:load projects={projects} />
		))
	}
</section>
