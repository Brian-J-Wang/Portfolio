---
import Footer from "@/components/footer/footer";
import "../styles/global.css";
import styles from "./layout.module.css";
import { buttonVariants } from "@/components/ui/button";
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/x-icon" href="/favicon.ico" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>Brian Wang</title>
	</head>
	<body>
		<header class={styles.header}>
			<div class={styles.header__content}>
				<div class="flex flex-col justify-center">
					<span class={styles.logo__name}> Brian Wang </span>
					<span class={styles.logo__job}> Software Developer </span>
				</div>
				<ul class={styles.header__navBar}>
					<li>
						<a href="/" class={buttonVariants({ variant: "link" })}
							>Home</a
						>
					</li>
					<li>
						<a
							href="/projects"
							class={buttonVariants({ variant: "link" })}
							>Projects</a
						>
					</li>
					<li>
						<a
							class={buttonVariants({ variant: "link" })}
							href="/resume.pdf"
							target="_blank"
							rel="noopener noreferrer">Resume</a
						>
					</li>
				</ul>
			</div>
		</header>
		<slot />
		<Footer client:visible />
	</body>
</html>
