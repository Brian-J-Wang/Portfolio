---
import Layout from "src/layouts/layout.astro";
import SectionHeader from "@/components/section/sectionHeader";
import SectionSubtitle from "@/components/section/sectionSubtitle";
import SectionTitle from "@/components/section/sectionTitle";
import { getProjects } from "@/components/projects/project.api";

const projects = getProjects();

const workProjects = projects.then((projects) => {
	return projects.filter(
		(project) => project.project_data.project_type === "work",
	);
});

const personalProjects = projects.then((projects) => {
	return projects.filter(
		(project) => project.project_data.project_type === "personal",
	);
});
---

<Layout>
	<section>
		<SectionHeader>
			<SectionTitle>My Work</SectionTitle>
			<SectionSubtitle> Some work I did for my clients. </SectionSubtitle>
		</SectionHeader>
		{(<div></div>)}
	</section>
	<section>
		<SectionHeader>
			<SectionTitle>Projects</SectionTitle>
			<SectionSubtitle>
				Personal Projects that I did for fun.
			</SectionSubtitle>
		</SectionHeader>
	</section>
</Layout>
