---
import SkillDisplay from "./components/display";
import { getProjects } from "@/components/projects/project.api";
import type { Project } from "@/components/projects/project.types";

let projects: Project[] = [];
try {
	projects = await getProjects();
} catch (error) {
	console.error("Failed to fetch projects in skills section:", error);
}
---

<section>
	<SkillDisplay client:load projects={projects} />
</section>
