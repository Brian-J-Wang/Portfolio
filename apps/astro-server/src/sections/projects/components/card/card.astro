---
import styles from "./card.module.css";
import type { SkillChipKeys } from "../skillChip/chips";
import Chip from "../skillChip/chip.astro";
import LinkButton from "../../../../components/linkButton/linkButton.astro";

interface Props {
	class: string;
	title: string;
	siteLink?: string;
	repoLink?: string;
	projectLink?: string;
	desc: string;
	skills?: SkillChipKeys[];
}

const {
	class: className,
	title,
	siteLink,
	repoLink,
	projectLink,
	desc,
	skills = [],
} = Astro.props as Props;
---

<div class={`${className} ${styles.card}`}>
	<div class={styles.card__projectImage}>
		{
			(siteLink || repoLink) && (
				<div class={styles.card__whiteSpace}>
					<img
						src="neg-radius-top-left.svg"
						alt="negative-radius"
						aria-hidden="true"
						class={styles.card__negativeRadius}
					/>
					{repoLink && (
						<LinkButton
							link={repoLink}
							icon="github.svg"
							alt="link to github repo"
						/>
					)}
					{siteLink && (
						<LinkButton
							link={siteLink}
							icon="link-external.svg"
							alt="link to site"
						/>
					)}
					<img
						src="neg-radius-top-left.svg"
						alt="negative-radius"
						aria-hidden="true"
						class={styles.card__negativeRadius}
					/>
				</div>
			)
		}
	</div>
	<div class={styles.card__content}>
		<div class="mb-4">
			<h3 class={styles.card__title}>
				{title ?? "Title is Missing"}
			</h3>
			<span class="flex flex-row gap-2">
				{skills.map((skill) => <Chip chip={skill} />)}
			</span>
		</div>
		<p class={styles.card__desc}>{desc}</p>
		<a class={styles.card__moreInfoButton} href={projectLink}>
			Read More
		</a>
	</div>
</div>
