---
import styles from "./hero.module.css";
---

<section class={styles.hero}>
	<div class={styles.hero__content}>
		<div class={styles.heroContent__message}>
			<h2 class={styles.heroContent__header}>Hello There!</h2>
			<p>
				I build full stack web apps using Astro, TypeScript, HTML/CSS,
				and React for the frontend while using NodeJs, ExpressJS, and
				Docker for the backend.
			</p>
			<p>
				When not programming, I like to go hiking in New England. I'm
				currently trying to complete the Terrifying 25.
			</p>
		</div>
		<div class={styles.hero__displayCase}></div>
	</div>
	<div class={styles.hero__profileImageContainer}>
		<img
			src="profile.png"
			alt="Casual image of me waving"
			class={styles.hero__profileImage}
		/>
		<div class={styles.hero__socials}>
			<div class={styles.hero__socialsNegativeRadius}>
				<img src="neg-radius-bottom-right.svg" alt="" />
			</div>
			<div class={styles.hero__socialsIcon}>
				<a
					href="https://www.linkedin.com/in/brian-j-wang/"
					target="_blank"
				>
					<img src="linkedin.svg" alt="linkedin svg" /></a
				>
			</div>
			<div class={styles.hero__socialsIcon}>
				<a href="https://github.com/Brian-J-Wang" target="_blank">
					<img src="github.svg" alt="github svg" />
				</a>
			</div>
			<div class={styles.hero__socialsNegativeRadius}>
				<img src="neg-radius-bottom-right.svg" alt="" />
			</div>
		</div>
	</div>
</section>
